import { Redis } from '@upstash/redis';

// Reads the connection details Vercel injects when you attach a database
// from the Storage tab. Vercel sometimes prefixes these with the resource
// name (e.g. "buildsource_KV_REST_API_URL"), so we search for any variable
// ending in the expected suffix rather than requiring an exact name.
function findEnvValue(suffixes: string[]): string | undefined {
  for (const suffix of suffixes) {
    if (process.env[suffix]) return process.env[suffix];
  }
  const keys = Object.keys(process.env);
  for (const suffix of suffixes) {
    const match = keys.find((k) => k.endsWith('_' + suffix));
    if (match && process.env[match]) return process.env[match];
  }
  return undefined;
}

function getRedis(): Redis | null {
  const url = findEnvValue(['KV_REST_API_URL', 'UPSTASH_REDIS_REST_URL']);
  const token = findEnvValue(['KV_REST_API_TOKEN', 'UPSTASH_REDIS_REST_TOKEN']);
  if (!url || !token) return null;
  return new Redis({ url, token });
}

// Only these keys may be read/written through this endpoint.
const ALLOWED_KEYS = new Set([
  'bst_products_v1',
  'bst_categories_v1',
  'bst_quotes_v1',
  'bst_settings_v1',
  'bst_locations_v1',
  'bst_projects_v1',
]);

export default async function handler(req: any, res: any) {
  const redis = getRedis();

  if (!redis) {
    res.status(503).json({
      error:
        'No database is connected to this project yet. In the Vercel dashboard, open this project, go to the Storage tab, add a Redis/KV database, then redeploy.',
    });
    return;
  }

  const key = Array.isArray(req.query?.key) ? req.query.key[0] : req.query?.key;

  if (!key || !ALLOWED_KEYS.has(key)) {
    res.status(400).json({ error: 'Invalid or missing key' });
    return;
  }

  try {
    if (req.method === 'GET') {
      const value = await redis.get(key);
      res.status(200).json({ key, value: value ?? null });
      return;
    }

    if (req.method === 'POST') {
      let body = req.body;
      if (typeof body === 'string') {
        try {
          body = JSON.parse(body);
        } catch {
          body = {};
        }
      }
      const value = body?.value ?? null;
      await redis.set(key, value);
      res.status(200).json({ key, ok: true });
      return;
    }

    res.status(405).json({ error: 'Method not allowed' });
  } catch (err: any) {
    res.status(500).json({ error: err?.message || 'Storage error' });
  }
}
